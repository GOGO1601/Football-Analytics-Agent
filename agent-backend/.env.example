GROQ_API_KEY=
MODEL_ROUTER=llama-3.1-8b-instant
MODEL_SYNTH=llama-3.3-70b-versatile
USE_MOCK_LLM=true
APP_ENV=development
# Browser origins allowed to call the API (comma-separated, no '*'). 63342 = WebStorm's built-in server.
CORS_ORIGINS=http://localhost:63342,http://127.0.0.1:63342
PRELOAD_DATA=true
PROMPT_VERSION=v1
CACHE_ENABLED=true
PARALLEL_ANALYSTS=true
DATA_DIR=../datasets
MLFLOW_TRACKING_URI=file:./mlruns
